{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "yyyy-MM-dd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "nrv.clock",
          "verticalFormat": "HH\n—\nmm",
          "interval": 1
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "nrv.menu"
        },
        {
          "id": "nrv.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "cpu",
          "type": "command",
          "exec": "$HOME/.config/omarchy/bar/scripts/cpu-status",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "temp",
          "type": "command",
          "exec": "$HOME/.config/omarchy/bar/scripts/temp-status",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "ram",
          "type": "command",
          "exec": "$HOME/.config/omarchy/bar/scripts/ram-status",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "disk",
          "type": "command",
          "exec": "$HOME/.config/omarchy/bar/scripts/disk-status",
          "interval": 15,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "nrv.menu"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "nrv.menu"
  ]
}
