# pnpm
export PNPM_HOME="/home/nrv/.local/share/pnpm"
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# pyenv (lazy-loaded to save ~65ms on shell startup)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"

_pyenv_init() {
    unset -f python python3 pyenv
    eval "$(pyenv init - bash)"
}
python() {
    _pyenv_init
    python "$@"
}
python3() {
    _pyenv_init
    python3 "$@"
}
pyenv() {
    _pyenv_init
    pyenv "$@"
}

export PATH="$HOME/.cargo/bin:$PATH"
. "$HOME/.rokit/env"
